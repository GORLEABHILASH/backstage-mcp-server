{
  "mcpServers": {
    "backstage": {
      "command": "/absolute/path/to/backstage-mcp-server/bin/backstage-mcp-server",
      "args": [],
      "env": {
        "BACKSTAGE_URL": "http://localhost:7007",
        "BACKSTAGE_TOKEN": "",
        "CHROMA_URL": "http://localhost:8000",
        "CHROMA_COLLECTION": "backstage_techdocs",
        "OPENAI_API_KEY": "",
        "EMBED_MODEL": "text-embedding-3-small"
      }
    }
  }
}
